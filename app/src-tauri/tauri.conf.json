{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QloudiCable",
  "version": "0.1.0",
  "identifier": "com.qloudihub.qloudicable",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QloudiCable",
        "width": 980,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "qloudihub.com",
    "copyright": "\u00a9 2026 qloudihub.com",
    "category": "Utility",
    "shortDescription": "What can this USB-C cable actually do?",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
